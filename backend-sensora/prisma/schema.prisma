generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                      Int            @id @default(autoincrement())
  nome                    String
  email                   String         @unique
  senha                   String
  perfil                  PerfilUsuario
  ativo                   Boolean        @default(true)
  // Etapa 8.3 (achado HIGH da auditoria — resetToken em texto puro) — grava
  // o HASH SHA-256 do token de redefinição de senha, nunca o token original
  // (mesmo mecanismo já usado por emailVerificationHash/RefreshToken.
  // tokenHash — AuthService.hashToken()). Renomeado de `resetToken` para
  // `resetTokenHash` de propósito: o nome antigo convidava a um futuro
  // dev/reviewer a assumir (incorretamente) que o valor era o token em
  // texto puro comparável diretamente. @unique pelo mesmo motivo de
  // emailVerificationHash logo abaixo.
  resetTokenHash          String?        @unique
  resetTokenExpiry        DateTime?
  // Etapa 6.4 (Confirmação de e-mail) — @default(true) é deliberado, não um
  // descuido: cobre de uma vez só duas exigências aprovadas (i) contas já
  // existentes no banco recebem `true` automaticamente quando a coluna é
  // criada (backfill do Postgres via DEFAULT, sem passo de migração
  // separado) e (ii) contas criadas pelo painel administrativo (ADMIN/
  // VENDEDOR, UsuariosController.create -> UsuariosService.create sem a
  // opção emailVerificado) também nascem `true`, sem precisar de nenhum
  // código especial para elas. Só o cadastro público (AuthService.register)
  // grava `false` explicitamente ao criar a conta — ver UsuariosService.create.
  emailVerificado         Boolean        @default(true)
  emailVerificadoEm       DateTime?
  // Hash SHA-256 do token de confirmação (nunca o token em texto puro —
  // mesmo raciocínio de RefreshToken.tokenHash). Campo próprio, nunca
  // reaproveita resetTokenHash/resetTokenExpiry: são fluxos diferentes
  // (trocar senha vs. confirmar e-mail), e misturar os dois no mesmo campo
  // abriria a possibilidade de um token de um fluxo ser aceito no outro.
  emailVerificationHash   String?        @unique
  emailVerificationExpiry DateTime?
  // MÉDIO-3 (e-mail pendente) — troca de e-mail em Minha Conta. `email`
  // continua sendo o endereço oficial até o novo ser confirmado; o novo
  // fica aqui, com o hash SHA-256 do token e a validade. Campos próprios,
  // separados de emailVerificationHash (confirmação de cadastro), para que
  // um token de um fluxo nunca seja aceito no outro. `emailPendente` sem
  // @unique de propósito: o pendente não reserva o endereço; o @unique de
  // `email` decide na confirmação.
  emailPendente           String?
  emailPendenteTokenHash  String?        @unique
  emailPendenteExpiraEm   DateTime?
  // Etapa — Dados do Cliente / Cadastro. Ambos opcionais (nunca exigidos no
  // cadastro público, só preenchíveis depois em Minha Conta — ver
  // AtualizarMeusDadosDto). Sempre normalizados antes de persistir (só
  // dígitos, sem pontuação/máscara — ver CpfUtil/TelefoneUtil em
  // usuarios.service.ts), nunca o valor formatado que o usuário digitou.
  // `cpf` é @unique: é identificador de pessoa física, uma duplicidade
  // silenciosa atrapalharia qualquer reconciliação futura (fiscal,
  // antifraude). `telefone` deliberadamente SEM @unique — é dado de
  // contato, comumente compartilhado entre pessoas (família/empresa),
  // um unique aqui geraria fricção sem ganho de segurança real (ver
  // auditoria "Dados do Cliente / Cadastro").
  cpf                     String?        @unique
  telefone                String?
  refreshTokens           RefreshToken[]
  pedidos                 Pedido[]
  enderecos               Endereco[]
  // Devoluções: as solicitadas pelo próprio usuário (cliente) e as que ele
  // analisou (ADMIN). Duas relações com Devolucao, por isso os nomes.
  devolucoes              Devolucao[]    @relation("DevolucaoUsuario")
  devolucoesAnalisadas    Devolucao[]    @relation("DevolucaoAnalisadoPor")
  devolucoesConferidas    Devolucao[]    @relation("DevolucaoConferidoPor")
}

// Task 8 (Carrinho/Checkout) — endereços de entrega do próprio usuário
// autenticado, usados no checkout. `usuarioId` nunca vem do corpo da
// requisição: sempre extraído do JWT (ver EnderecosController), e todo
// acesso (find/update/remove) é filtrado por usuarioId + id juntos, para
// que um usuário nunca veja/altere o endereço de outro.
model Endereco {
  id          Int     @id @default(autoincrement())
  usuarioId   Int
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  cep         String
  padrao      Boolean @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Task 27 — refresh token opaco (não é um JWT): só o hash (SHA-256) é
// persistido, nunca o token em texto puro, mesmo raciocínio de nunca
// guardar senha em claro. Uma linha por sessão/dispositivo — várias linhas
// ativas por usuarioId são o suporte nativo a múltiplas sessões.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Cliente {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String
  telefone String
  cpf      String
  endereco String
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nome      String
  slug      String    @unique
  descricao String?
  produtos  Produto[]
}

model Produto {
  id          Int          @id @default(autoincrement())
  nome        String
  slug        String       @unique
  descricao   String?
  preco       Decimal      @db.Decimal(10, 2)
  quantidade  Int
  imagemUrl   String?
  aroma       String?
  ativo       Boolean      @default(true)
  destaque    Boolean      @default(false)
  categoriaId Int?
  itensPedido ItemPedido[]
  categoria   Categoria?   @relation(fields: [categoriaId], references: [id])
}

model Pedido {
  id              Int          @id @default(autoincrement())
  numero          String
  data            DateTime
  status          StatusPedido @default(PENDENTE)
  total           Decimal      @db.Decimal(10, 2)
  // Legado (Stripe) — preservado só para pedidos antigos e para o modo de
  // rollback (CHECKOUT_GATEWAY="stripe"), ver Task 21.
  stripeSessionId String?      @unique
  // Id do Asaas Checkout — gateway ativo por padrão a partir da Task 21.
  asaasCheckoutId String?      @unique
  // Etapa 5B.2 (modelagem para reembolso) — id do Payment real na Asaas
  // (formato pay_xxx), distinto de asaasCheckoutId (id do Checkout). Ainda
  // não é preenchido por nenhum código nesta etapa — a resolução (via
  // GET /payments?checkoutSession= ou persistido em confirmarPagamento)
  // fica para uma etapa futura (5B.3+). @unique: um Payment real da Asaas
  // nunca se repete entre pedidos diferentes (é o identificador primário
  // deles); nulo não conflita com nulo no Postgres, então não há risco de
  // violar a constraint enquanto o campo não é populado — mesmo padrão já
  // usado em asaasCheckoutId/stripeSessionId acima.
  asaasPaymentId  String?      @unique
  clienteEmail    String?
  clienteNome     String?
  usuarioId       Int?
  itens           ItemPedido[]

  // Etapa 6.5 (Frete) — snapshot do endereço de entrega usado NESTA compra,
  // copiado de Endereco no momento da criação do pedido (CheckoutService.
  // createSession). Deliberadamente SEM relação/FK com Endereco: um pedido
  // já criado nunca pode mudar de endereço de entrega junto com uma edição
  // futura do cadastro do cliente, nem sumir se o cliente excluir aquele
  // endereço depois — por isso são campos soltos, não uma referência.
  // `clienteNome` (já existente acima) é reaproveitado como nome do
  // destinatário: é o mesmo nome informado no checkout para o mesmo pedido,
  // nunca um segundo campo redundante para a mesma informação.
  enderecoCep         String?
  enderecoRua         String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoEstado      String?

  // Etapa 6.5 (Frete) — resultado da cotação escolhida pelo cliente e
  // validada pelo backend (nunca o preço/prazo enviados pelo cliente, ver
  // CheckoutService.criarSessaoAsaas/criarSessaoStripe). `freteServicoId` é
  // o id do serviço na Melhor Envio (ex.: 1 = Correios PAC) — preservado
  // separado de `freteTransportadora`/`freteServico` (nomes, só para
  // exibição) porque é o identificador estável para uma eventual compra de
  // etiqueta futura (Parte 7 da etapa, ainda não implementada).
  freteValor          Decimal? @db.Decimal(10, 2)
  freteTransportadora String?
  freteServico        String?
  fretePrazoDias      Int?
  freteServicoId      Int?

  // Etapa 6.6 (Status de Envio) — eixo logístico, independente de `status`
  // (financeiro). @default(NAO_ENVIADO): pedidos existentes assumem esse
  // valor automaticamente na migration, sem precisar de backfill manual.
  // `enviadoEm` só é preenchido pela transição NAO_ENVIADO -> ENVIADO em
  // PedidosService.marcarComoEnviado — nunca escrito em nenhum outro lugar
  // (create/update genérico não aceitam este campo, ver CreatePedidoDto/
  // UpdatePedidoDto), então não há como um pedido nascer "ENVIADO".
  statusEnvio StatusEnvio @default(NAO_ENVIADO)
  enviadoEm   DateTime?

  // Achado da auditoria: usuarioId já era usado pela aplicação (ver
  // PedidosService.podeAcessar) para restringir VENDEDOR aos próprios
  // pedidos, mas nunca teve uma FK real no banco. onDelete: SetNull mantém o
  // histórico do pedido mesmo se o Usuario dono for excluído, em vez de
  // deixar a coluna apontando para um id que não existe mais.
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  // Infraestrutura Fiscal (preparação arquitetural, ver vistoria "infra
  // neutra para futura emissão de notas fiscais") — relação opcional 1:1:
  // nenhum código cria NotaFiscal automaticamente ainda (FiscalService não é
  // chamado por CheckoutService.confirmarPagamento nesta etapa), então todo
  // Pedido existente/futuro continua sem nota até uma etapa posterior ligar
  // os dois. Ver comentário completo em NotaFiscal, abaixo.
  notaFiscal NotaFiscal?

  // Solicitações de devolução deste pedido (ver Devolucao, abaixo).
  devolucoes Devolucao[]

  // Vistoria do Dashboard operacional (Admin) — DashboardService agora
  // agrega Pedido por status (contagem/soma de total) e ordena/filtra por
  // data para as métricas do painel, além do uso já existente de `status`
  // (PedidosService.garantirMutavel/cancelar/etc.) e `data` (ordenação de
  // GET /pedidos). Sem estes índices, cada agregação faria um full scan de
  // Pedido — aceitável hoje pelo volume baixo, mas seria o próximo gargalo
  // assim que o histórico de pedidos crescer. Não altera nenhuma query
  // existente, só acelera o plano de execução do Postgres.
  @@index([status])
  @@index([data])
}

model ItemPedido {
  id                Int             @id @default(autoincrement())
  pedidoId          Int
  produtoId         Int
  quantidade        Int
  precoUnitario     Decimal         @db.Decimal(10, 2)
  subtotal          Decimal         @db.Decimal(10, 2)
  // Etapa 5A.2 (achado da auditoria 5A.1) — rastreia POR ITEM se o estoque
  // deste item específico já foi efetivamente decrementado (via
  // ItensPedidoService.create no fluxo admin, ou via
  // CheckoutService.confirmarPagamento na confirmação de pagamento).
  // Nunca inferido pela origem do Pedido inteiro (asaasCheckoutId etc.):
  // um mesmo pedido pode ter itens mistos (ex.: item do checkout + item
  // adicionado depois pelo admin), e só o rastreio por item resolve isso
  // corretamente. Permanece `true` para sempre depois de decrementado —
  // não é "saldo atual", é proveniência: PedidosService.cancelar() só lê
  // este campo para decidir se restaura, nunca escreve `false` de volta.
  // `null` = registro histórico anterior a esta migration, indeterminado —
  // nunca tratar como true/false automaticamente (ver PedidosService.cancelar,
  // que bloqueia o cancelamento com erro controlado nesse caso).
  estoqueBaixado    Boolean?
  // Etapa 5B.2 (modelagem para reembolso) — distinto de estoqueBaixado:
  // aquele é proveniência (o estoque deste item foi decrementado alguma
  // vez?), este é se essa baixa já foi devolvida (seja por cancelamento de
  // PENDENTE — Etapa 5A.2 — seja, futuramente, por reembolso confirmado de
  // PAGO). Nenhum código ainda seta este campo como true nesta etapa
  // (PedidosService.cancelar continua sem alteração de comportamento) —
  // só a coluna existe, com default false, preparando a idempotência da
  // restauração de estoque no reembolso (5B.6).
  estoqueRestaurado Boolean         @default(false)
  pedido            Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto           Produto         @relation(fields: [produtoId], references: [id])
  itensDevolucao    ItemDevolucao[]
}

// Solicitação de devolução de um pedido já pago/enviado. Ciclo de vida em
// `status` (ver StatusDevolucao) — eixo próprio, independente de
// Pedido.status (financeiro) e Pedido.statusEnvio (logístico), mesmo
// raciocínio já usado para separar esses dois.
//
// Histórico nunca é apagado por cascata:
// - pedido: onDelete Restrict — um Pedido com devolução não pode ser
//   excluído (hoje só PENDENTE pode ser excluído, e ele nunca tem devolução).
// - usuario/analisadoPor: onDelete SetNull — mesmo padrão de Pedido.usuario:
//   excluir o Usuario mantém a devolução.
//
// Regras comerciais (prazo, frete, motivos aceitos, produtos não
// devolvíveis) ainda não foram definidas e ficam fora do schema.
model Devolucao {
  id                    Int             @id @default(autoincrement())
  pedidoId              Int
  usuarioId             Int?
  // Texto livre: a lista de motivos aceitos ainda não foi definida.
  motivo                String
  descricao             String?
  status                StatusDevolucao @default(SOLICITADA)
  solicitadaEm          DateTime        @default(now())
  // Preenchidos quando a devolução é aprovada ou recusada.
  analisadaEm           DateTime?
  observacaoAnalise     String?
  analisadoPorId        Int?
  // Etapa 8 — quando o ADMIN confirmou que o produto chegou (ENVIADA -> RECEBIDA).
  recebidaEm            DateTime?
  // Etapa 9.1 — conferência física (EM_CONFERENCIA) e fechamento. A
  // conferência é registrada uma única vez (conferidaEm) e define
  // reembolsoValor = soma de quantidadeAceita x precoUnitario dos itens
  // (0 quando nada foi aceito). asaasRefundId é o estorno desta devolução
  // no Asaas; reembolsadaEm, a confirmação dele (status DONE).
  // estoqueRestauradoEm marca a devolução única das unidades aceitas ao
  // estoque, feita junto com a confirmação do reembolso.
  conferidaEm           DateTime?
  conferidoPorId        Int?
  observacaoConferencia String?
  reembolsoValor        Decimal?        @db.Decimal(10, 2)
  asaasRefundId         String?         @unique
  reembolsadaEm         DateTime?
  estoqueRestauradoEm   DateTime?
  atualizadoEm          DateTime        @updatedAt

  pedido       Pedido               @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  usuario      Usuario?             @relation("DevolucaoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  analisadoPor Usuario?             @relation("DevolucaoAnalisadoPor", fields: [analisadoPorId], references: [id], onDelete: SetNull)
  conferidoPor Usuario?             @relation("DevolucaoConferidoPor", fields: [conferidoPorId], references: [id], onDelete: SetNull)
  itens        ItemDevolucao[]
  evidencias   EvidenciaDevolucao[]
  envio        EnvioDevolucao?

  // pedidoId/usuarioId: devoluções de um pedido e "minhas devoluções" do
  // cliente. status/solicitadaEm: fila e ordenação da listagem do Admin.
  @@index([pedidoId])
  @@index([usuarioId])
  @@index([status])
  @@index([solicitadaEm])
}

// Item do pedido incluído numa devolução. `quantidade` nunca pode passar da
// quantidade comprada em ItemPedido (somando todas as devoluções do mesmo
// item) — validado no service quando a criação for implementada.
// `precoUnitario` é copiado de ItemPedido.precoUnitario na criação (mesmo
// nome), para o valor a devolver nunca depender do preço atual do Produto.
model ItemDevolucao {
  id               Int     @id @default(autoincrement())
  devolucaoId      Int
  itemPedidoId     Int
  quantidade       Int
  precoUnitario    Decimal @db.Decimal(10, 2)
  // Etapa 9.1 — unidades aprovadas na conferência física (0..quantidade).
  // É o que é reembolsado e o que volta ao estoque; nulo antes da conferência.
  quantidadeAceita Int?

  // Cascade só a partir da própria Devolucao (item não existe sem ela);
  // Restrict no ItemPedido para nunca perder o item devolvido.
  devolucao  Devolucao  @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)
  itemPedido ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Restrict)

  // Um mesmo ItemPedido aparece no máximo uma vez por devolução.
  // itemPedidoId: somar o que já foi devolvido de um item.
  @@unique([devolucaoId, itemPedidoId])
  @@index([itemPedidoId])
}

// Etapa 8 — logística reversa da devolução (envio pago pela loja). O cliente
// não usa etiqueta: apresenta nos Correios o código de devolução. No máximo
// um envio por devolução: o @unique em devolucaoId é o que impede duas
// cobranças, mesmo com dois ADMINs ao mesmo tempo. Os passos já concluídos
// ficam marcados (idExterno, compradaEm, geradaEm), e é por eles que uma
// geração interrompida é retomada. Nenhuma URL de documento é guardada: é
// pedida ao provedor a cada acesso.
model EnvioDevolucao {
  id                   Int       @id @default(autoincrement())
  devolucaoId          Int       @unique
  provedor             String    @default("MELHOR_ENVIO")
  // Id do envio no provedor — gravado logo depois de criado.
  idExterno            String?   @unique
  servicoId            Int
  transportadora       String
  servico              String
  custo                Decimal   @db.Decimal(10, 2)
  compradaEm           DateTime?
  geradaEm             DateTime?
  // Código que o cliente apresenta nos Correios (liberado pela geração).
  codigoDevolucao      String?
  // Rastreio do objeto, quando o provedor informar.
  codigoRastreio       String?
  // Só a última situação conhecida do rastreio (o histórico fica no provedor).
  postadaEm            DateTime?
  situacaoRastreio     String?
  rastreioAtualizadoEm DateTime?
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt

  // Restrict: um envio pago nunca some junto com a devolução.
  devolucao Devolucao @relation(fields: [devolucaoId], references: [id], onDelete: Restrict)
}

// Foto enviada pelo cliente como evidência da devolução. O arquivo fica
// PRIVADO no ImageKit: aqui só ficam o fileId (para apagar) e o caminho
// (para gerar uma URL assinada de validade curta na hora de exibir) —
// nunca uma URL pública. Máximo de 5 por devolução (DevolucoesService).
model EvidenciaDevolucao {
  id          Int      @id @default(autoincrement())
  devolucaoId Int
  fileId      String
  caminho     String
  criadoEm    DateTime @default(now())

  // Cascade só a partir da própria Devolucao, mesmo padrão de ItemDevolucao.
  devolucao Devolucao @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)

  // devolucaoId: listar e contar as fotos de uma devolução.
  @@index([devolucaoId])
}

// Infraestrutura Fiscal (preparação arquitetural) — modelo intencionalmente
// "neutro": guarda o RESULTADO de uma futura emissão (identificadores,
// arquivos, erro, tentativas) e um SNAPSHOT próprio dos dados do
// destinatário, mas não define NF-e vs NFC-e, não modela NCM/CFOP/CST/
// CSOSN/impostos, e não amarra a nenhum provedor específico — isso fica para
// uma etapa futura, quando FiscalProvider ganhar uma implementação real (ver
// src/fiscal/). Nenhum código cria linhas aqui automaticamente nesta etapa:
// FiscalService existe, mas não é chamado por CheckoutService.
// confirmarPagamento nem por nenhum outro fluxo de pagamento — ver
// FiscalService para o raciocínio completo.
//
// Cardinalidade 1:1 com Pedido (pedidoId @unique): tentativas de emissão são
// rastreadas pelo contador `tentativas` numa ÚNICA linha por pedido, nunca
// por uma linha nova a cada tentativa — mesmo princípio de "estado atual",
// não histórico, já usado em Pedido.status (uma transição sobrescreve, não
// acumula).
model NotaFiscal {
  id       Int          @id @default(autoincrement())
  pedidoId Int          @unique
  status   StatusFiscal @default(NAO_EMITIDA)

  // Identificadores do documento fiscal emitido pelo provedor — todos
  // opcionais porque só existem DEPOIS de uma emissão bem-sucedida (nenhum
  // código os preenche nesta etapa). Deliberadamente sem formato/tamanho
  // assumido (ex.: chaveAcesso não é fixada em 44 dígitos): não é papel
  // desta etapa decidir o formato de documento fiscal.
  numero      String?
  serie       String?
  chaveAcesso String?
  protocolo   String?

  // Referência/localização dos arquivos gerados pelo provedor (XML e
  // PDF/DANFE) — nunca o conteúdo binário em si, e nunca assumido como URL
  // pública: pode ser um path de storage interno, uma URL assinada, etc.,
  // a decidir na etapa que implementar a emissão real.
  xmlUrl String?
  pdfUrl String?

  // Diagnóstico da tentativa mais recente — sempre sobrescrito pela última
  // tentativa (não é log acumulado; observabilidade histórica, se necessária
  // no futuro, fica fora do escopo desta preparação). `tentativas` existe
  // para uma futura política de retry decidir quando desistir — nenhuma
  // lógica de retry é implementada aqui.
  mensagemErro String?
  tentativas   Int     @default(0)

  // Snapshot fiscal — cópia própria dos dados do destinatário no momento em
  // que uma futura emissão (ou tentativa) capturar esses dados, para nunca
  // mais depender de Usuario/Endereco depois disso (mesmo princípio já
  // usado no snapshot de endereço/frete de Pedido, acima: um documento já
  // emitido não pode mudar retroativamente porque o cliente editou o
  // cadastro). `destinatarioDocumento` é neutro de propósito (não distingue
  // CPF de CNPJ nem exige preenchimento) — Usuario.cpf continua opcional no
  // cadastro/checkout, isso não muda aqui. Todos opcionais porque nenhum
  // código ainda os preenche nesta etapa.
  destinatarioNome      String?
  destinatarioDocumento String?
  destinatarioEmail     String?
  enderecoCep           String?
  enderecoRua           String?
  enderecoNumero        String?
  enderecoComplemento   String?
  enderecoBairro        String?
  enderecoCidade        String?
  enderecoEstado        String?

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  emitidoEm    DateTime?

  // onDelete: Cascade — mesmo padrão de ItemPedido acima: NotaFiscal é um
  // registro satélite de Pedido, sem valor próprio se o pedido deixar de
  // existir. Na prática, hoje só Pedido PENDENTE pode ser excluído
  // (PedidosService.remove), estado em que uma nota ainda não faria
  // sentido existir — a constraint só formaliza a garantia para o futuro.
  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

// Etapa 6.5 (Frete) — par access_token/refresh_token OAuth2 da conta da loja
// no Melhor Envio. Linha única (id sempre 1, ver MelhorEnvioService): não há
// "um token por usuário" aqui — é a credencial da LOJA junto ao Melhor
// Envio, obtida uma vez via fluxo de autorização (Parte 2 da etapa) e
// renovada sozinha via refresh_token quando expira. Nunca exposta em
// nenhuma resposta de API — só lida/escrita pelo próprio MelhorEnvioService.
//
// Etapa 8.4 (achado HIGH da auditoria — tokens em texto puro): accessToken/
// refreshToken armazenam CIPHERTEXT (AES-256-GCM, formato
// "v1:<iv>:<authTag>:<ciphertext>", tudo em base64), nunca o token OAuth em
// texto puro — ver MelhorEnvioTokenCryptoService. Diferente de
// resetTokenHash/emailVerificationHash (hash, uso único): aqui a
// criptografia precisa ser REVERSÍVEL, porque o backend precisa apresentar
// o token original de volta para a API do Melhor Envio a cada chamada.
// Nenhuma alteração de tipo/coluna foi necessária (String já comportava o
// ciphertext) — só o CONTEÚDO gravado mudou; ver scripts/migrate-melhor-envio-tokens.ts
// para a migração controlada do valor já existente no banco.
model MelhorEnvioToken {
  id           Int      @id @default(1)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  atualizadoEm DateTime @updatedAt
}

enum PerfilUsuario {
  ADMIN
  VENDEDOR
  CLIENTE
}

enum StatusPedido {
  PENDENTE
  PAGO
  CANCELADO
  // Etapa 5B.2 (modelagem para reembolso, ver auditoria 5B.1) — nenhum
  // código ainda transiciona um Pedido para estes dois estados nesta etapa;
  // só a modelagem existe, preparando PAGO -> REEMBOLSO_SOLICITADO ->
  // REEMBOLSADO das próximas etapas (5B.3+).
  REEMBOLSO_SOLICITADO
  REEMBOLSADO
}

// Etapa 6.6 (Status de Envio) — deliberadamente um enum PRÓPRIO, nunca um
// valor a mais dentro de StatusPedido: aquele é só o ciclo de vida
// financeiro (cobrança/estorno), este é logístico, e a auditoria desta
// etapa concluiu que misturar os dois conceitos no mesmo campo seria
// incorreto (ex.: um pedido PAGO pode estar tanto NAO_ENVIADO quanto
// ENVIADO — são eixos independentes). MVP cobre só NAO_ENVIADO -> ENVIADO;
// ENTREGUE (e qualquer rastreamento real) fica fora de propósito, para uma
// etapa futura — ver auditoria da Etapa 6.6.
enum StatusEnvio {
  NAO_ENVIADO
  ENVIADO
}

// Ciclo de vida de uma Devolucao (quarto eixo, independente dos status do
// Pedido). Caminho normal: SOLICITADA -> EM_ANALISE -> APROVADA ->
// AGUARDANDO_ENVIO -> ENVIADA -> RECEBIDA -> EM_CONFERENCIA -> CONCLUIDA.
// RECUSADA e CANCELADA encerram a devolução.
enum StatusDevolucao {
  SOLICITADA
  EM_ANALISE
  APROVADA
  RECUSADA
  // Cliente precisa postar o produto de volta.
  AGUARDANDO_ENVIO
  // Cliente postou o produto (mesmo termo de StatusEnvio.ENVIADO).
  ENVIADA
  RECEBIDA
  EM_CONFERENCIA
  CONCLUIDA
  CANCELADA
}

// Infraestrutura Fiscal (preparação arquitetural) — terceiro eixo
// independente, mesmo raciocínio já usado para separar StatusEnvio de
// StatusPedido acima: um pedido PAGO pode estar em qualquer estado fiscal
// (inclusive NAO_EMITIDA, o único valor possível hoje, já que nenhum código
// ainda transiciona este campo) sem que isso influencie o status financeiro
// ou logístico do pedido. Valores pensados só como ciclo de vida de
// PROCESSAMENTO de um documento (enviado ao provedor / aceito / rejeitado /
// cancelado / erro de comunicação) — nenhum deles define NF-e vs NFC-e nem
// carrega significado tributário.
enum StatusFiscal {
  // Nenhuma tentativa de emissão foi feita ainda — valor inicial de toda
  // NotaFiscal (@default, ver model acima).
  NAO_EMITIDA
  // Emissão em andamento junto ao provedor (aguardando confirmação).
  PROCESSANDO
  // Provedor confirmou a emissão — numero/serie/chaveAcesso/protocolo
  // preenchidos.
  EMITIDA
  // Provedor recusou a emissão (ver mensagemErro para o motivo).
  REJEITADA
  // Falha de comunicação/infraestrutura ao tentar emitir (distinto de
  // REJEITADA — aqui não há confirmação de que o provedor sequer processou
  // a tentativa; mesma distinção que AsaasIndisponivelError/AsaasErroHttpError
  // já fazem para pagamento, ver asaas.service.ts).
  ERRO
  // Nota já emitida e depois cancelada (ex.: pedido cancelado/reembolsado
  // após a emissão) — nenhuma regra de quando isso é permitido é definida
  // nesta etapa.
  CANCELADA
}
